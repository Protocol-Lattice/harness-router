{
  "harness-router": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 .antigravity/hooks/pre_invocation.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .antigravity/hooks/pre_tool_use.py",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 .antigravity/hooks/pre_tool_use.py --stop",
        "timeout": 2
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .antigravity/hooks/post_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
